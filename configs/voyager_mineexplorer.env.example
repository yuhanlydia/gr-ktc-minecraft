# Optional original client/Microsoft launch configuration. The default local
# dedicated-server protocol below does not require these credentials.
MINECRAFT_DIR=/root/gr_ktc_minecraft/runtime/minecraft
MINECRAFT_VERSION=fabric-loader-0.14.18-1.19
MINECRAFT_REDIRECT_URL=https://127.0.0.1/auth-response
MINECRAFT_CLIENT_ID=
MINECRAFT_CLIENT_SECRET=

# Optional PEAM-paper slow-tier endpoint. Local Qwen acquisition leaves it empty.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Local VLM.
QWEN_MODEL_PATH=/root/gr_ktc_minecraft/models/Qwen3-VL-8B-Instruct
